{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "flowdesk-web": {
      "projectType": "application",
      "schematics": {"@schematics/angular:component": {"style": "scss"}},
      "root": "",
      "sourceRoot": "src",
      "prefix": "fd",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {"browser":"src/main.ts","tsConfig":"tsconfig.app.json","outputPath":"dist/flowdesk-web","index":"src/index.html","styles":["src/styles.scss"]}, "configurations":{"production":{"optimization":true,"outputHashing":"all"}}},
        "serve": {"builder":"@angular/build:dev-server","options":{"buildTarget":"flowdesk-web:build"}},
        "test": {"builder":"@angular/build:unit-test","options":{"buildTarget":"flowdesk-web:build"}}
      }
    }
  },
  "cli": {"analytics": false}
}
